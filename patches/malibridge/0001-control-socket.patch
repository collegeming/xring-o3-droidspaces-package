+static char budget_conf_path_buf[4096];
+static pthread_once_t budget_conf_path_once = PTHREAD_ONCE_INIT;
+
+static void budget_conf_path_init(void)
+{
+    const char *p = getenv("VKBRIDGE_CONTROL_CONF");
+    if (p && *p) {
+        snprintf(budget_conf_path_buf, sizeof(budget_conf_path_buf), "%s", p);
