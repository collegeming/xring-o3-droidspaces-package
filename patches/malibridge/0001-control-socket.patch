+    const char *path = vkb_mem_budget_conf_path();
+    char tmp[4200];
+    int tn = snprintf(tmp, sizeof(tmp), "%s.tmp.%d", path, (int)getpid());
+    if (tn < 0 || (size_t)tn >= sizeof(tmp)) {
+        if (err && err_len) snprintf(err, err_len, "budget.conf path is too long");
+        return -1;
+    }
+    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) {
+        if (err && err_len) snprintf(err, err_len, "open %s: %s", tmp, strerror(errno));
+        return -1;
+    }
+    char buf[320];
+    int n = snprintf(buf, sizeof(buf),
+                     "# MaliBridge memory budget (mbctl set --persist; read at startup where the environment is unset)\n"
+                     "total_mb=%lld\npid_mb=%lld\nfloor_mb=%lld\nmap_limit=%lld\n",
+                     (long long)cfg->total_mb, (long long)cfg->pid_mb, (long long)cfg->floor_mb, (long long)cfg->map_limit);
+    int ok = n > 0 && (size_t)n < sizeof(buf);
+    for (int off = 0; ok && off < n;) {
+        ssize_t w = write(fd, buf + off, (size_t)(n - off));
+        if (w < 0 && errno == EINTR) continue;
+        if (w <= 0) ok = 0;
