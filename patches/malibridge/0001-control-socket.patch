+/* The environment wins; a key the environment does not set comes from budget.conf. */
+static int64_t budget_setting(const char *env, const char *key, int64_t def, int *from_conf)
+{
+    const char *v = vkb_srv_env_global(env);
+    if (v && *v) return budget_env_num(env, def);
+    int64_t n = 0;
+    int r = budget_conf_get(vkb_mem_budget_conf_path(), key, &n);
+    if (r == 1) {
+        if (from_conf) *from_conf = 1;
+        return n;
+    }
+    if (r < 0) VKB_WARN("budget.conf: %s is not a number; default %lld used", key, (long long)def);
+    return def;
+}
