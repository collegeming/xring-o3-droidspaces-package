index 0000000..c632d8b
--- /dev/null
+++ b/server/server_control.c
@@ -0,0 +1,517 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 ASEbrahim and MaliBridge contributors
+ *
+ * The budget control socket (server_control.c).
+ *
+ * A second Unix socket beside the bridge's own, mode 0666, JSON lines, one reply per request:
+ *   {"cmd":"status"}
+ *   {"cmd":"set","total_mb":4096,"pid_mb":2048,"floor_mb":2048,"map_limit":60000,"persist":false}
+ * Every connection is checked with SO_PEERCRED: only the uids in VKBRIDGE_CONTROL_UIDS (default
+ * 1000) may ask. A line is at most 4096 bytes and only the keys below are accepted; anything else
+ * is answered with {"ok":false,...} and the connection closed. The thread serves the socket
+ * sequentially with a 2 s idle timeout, so a stuck client cannot wedge it. The budget itself is
+ * changed by server_memory.c under one lock; a lower limit does not kill a client, it only makes
+ * its later allocations fail with VK_ERROR_OUT_OF_DEVICE_MEMORY.
+ */
+#define _GNU_SOURCE
+#include "vkb_server.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef PATH_MAX
+#define PATH_MAX 4096
+#endif
+
+#define CTL_LINE_MAX 4096
+#define CTL_OUT_MAX 8192
+#define CTL_UIDS_MAX 8
+#define CTL_IDLE_MS 2000
+
+static int ctl_fd = -1;
+static char ctl_path[PATH_MAX];
+static uid_t ctl_uids[CTL_UIDS_MAX];
+static int ctl_nuids;
+
+static int64_t ctl_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static int ctl_send(int fd, const char *s, size_t n)
+{
+    while (n) {
+        ssize_t w = send(fd, s, n, MSG_NOSIGNAL);
+        if (w < 0 && errno == EINTR) continue;
+        if (w <= 0) return -1;
+        s += w;
+        n -= (size_t)w;
+    }
+    return 0;
+}
+
+static void ctl_escape(char *dst, size_t cap, const char *src)
+{
+    size_t o = 0;
+    if (!cap) return;
+    for (; src && *src && o + 7 < cap; src++) {
+        unsigned char c = (unsigned char)*src;
+        if (c == '"' || c == '\\') {
+            dst[o++] = '\\';
+            dst[o++] = (char)c;
+        } else if (c < 0x20) {
+            o += (size_t)snprintf(dst + o, cap - o, "\\u%04x", c);
+        } else {
+            dst[o++] = (char)c;
+        }
+    }
+    dst[o] = 0;
+}
+
+static int ctl_reply_error(int fd, const char *msg)
+{
+    char out[256];
+    int n = snprintf(out, sizeof(out), "{\"ok\":false,\"error\":\"%s\"}\n", msg);
+    return ctl_send(fd, out, (size_t)n);
+}
+
+static long ctl_rss_kb(void)
+{
+    char buf[4096];
+    int fd = open("/proc/self/status", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return 0;
+    ssize_t k = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    buf[k > 0 ? k : 0] = 0;
+    const char *p = strstr(buf, "VmRSS:");
+    return p ? strtol(p + 6, NULL, 10) : 0;
+}
+
+/* ------------------------------------------------------------------ request parsing */
+
+typedef struct {
+    int is_set;
+    int has_total, has_pid, has_floor, has_map, has_persist;
+    int64_t total_mb, pid_mb, floor_mb, map_limit;
+    int persist;
+} ctl_req;
+
+static const char *ctl_ws(const char *p, const char *e)
+{
+    while (p < e && (*p == ' ' || *p == '\t')) p++;
+    return p;
+}
+
+static int ctl_string(const char **pp, const char *e, char *out, size_t cap)
+{
+    const char *p = *pp;
+    size_t n = 0;
+    if (p >= e || *p != '"') return -1;
+    for (p++; p < e && *p != '"'; p++) {
+        unsigned char c = (unsigned char)*p;
+        if (c < 0x20) return -1;
+        if (c == '\\') {
+            if (++p >= e) return -1;
+            switch (*p) {
+            case '"': c = '"'; break;
+            case '\\': c = '\\'; break;
+            case '/': c = '/'; break;
+            case 'n': c = '\n'; break;
+            case 't': c = '\t'; break;
+            case 'r': c = '\r'; break;
+            case 'b': c = '\b'; break;
+            case 'f': c = '\f'; break;
+            default: return -1;
+            }
+        }
+        if (n + 1 >= cap) return -1;
+        out[n++] = (char)c;
+    }
+    if (p >= e || *p != '"') return -1;
+    out[n] = 0;
+    *pp = p + 1;
+    return 0;
+}
+
+static int ctl_int(const char **pp, const char *e, int64_t *out)
+{
+    const char *p = *pp;
+    int neg = 0;
+    int64_t v = 0;
+    if (p < e && *p == '-') neg = 1, p++;
+    if (p >= e || *p < '0' || *p > '9') return -1;
+    while (p < e && *p >= '0' && *p <= '9') {
+        int d = *p - '0';
+        if (v > (INT64_MAX - d) / 10) return -1;
+        v = v * 10 + d;
+        p++;
+    }
+    *out = neg ? -v : v;
+    *pp = p;
+    return 0;
+}
+
+static int ctl_lit(const char **pp, const char *e, const char *lit)
+{
+    size_t n = strlen(lit);
+    if ((size_t)(e - *pp) < n || memcmp(*pp, lit, n)) return -1;
+    *pp += n;
+    return 0;
+}
+
+static int ctl_parse(const char *line, size_t len, ctl_req *r, char *err, size_t err_len)
+{
+    const char *p = line, *e = line + len;
+    int seen = 0;
+    memset(r, 0, sizeof(*r));
+    p = ctl_ws(p, e);
+    if (p >= e || *p != '{') goto bad;
+    p = ctl_ws(p + 1, e);
+    if (p < e && *p == '}') {
+        p++;
+        goto end;
+    }
+    for (;;) {
+        char key[32];
+        p = ctl_ws(p, e);
+        if (ctl_string(&p, e, key, sizeof(key))) goto bad;
+        p = ctl_ws(p, e);
+        if (p >= e || *p != ':') goto bad;
+        p = ctl_ws(p + 1, e);
+        if (!strcmp(key, "cmd")) {
+            char v[16];
+            if (seen & 1) goto bad;
+            seen |= 1;
+            if (ctl_string(&p, e, v, sizeof(v))) goto bad;
+            if (!strcmp(v, "status")) r->is_set = 0;
+            else if (!strcmp(v, "set")) r->is_set = 1;
+            else goto bad;
+        } else if (!strcmp(key, "total_mb") || !strcmp(key, "pid_mb") || !strcmp(key, "floor_mb") || !strcmp(key, "map_limit")) {
+            int64_t *dst = !strcmp(key, "total_mb") ? &r->total_mb : !strcmp(key, "pid_mb") ? &r->pid_mb : !strcmp(key, "floor_mb") ? &r->floor_mb : &r->map_limit;
+            int bit = !strcmp(key, "total_mb") ? 2 : !strcmp(key, "pid_mb") ? 4 : !strcmp(key, "floor_mb") ? 8 : 16;
+            if (seen & (1 << bit)) goto bad;
+            seen |= 1 << bit;
+            if (ctl_int(&p, e, dst)) goto bad;
+            if (bit == 2) r->has_total = 1;
+            else if (bit == 4) r->has_pid = 1;
+            else if (bit == 8) r->has_floor = 1;
+            else r->has_map = 1;
+        } else if (!strcmp(key, "persist")) {
+            if (seen & 32) goto bad;
+            seen |= 32;
+            if (!ctl_lit(&p, e, "true")) r->persist = 1;
+            else if (!ctl_lit(&p, e, "false")) r->persist = 0;
+            else goto bad;
+            r->has_persist = 1;
+        } else {
+            goto bad; /* unknown key */
+        }
+        p = ctl_ws(p, e);
+        if (p < e && *p == ',') {
+            p++;
+            continue;
+        }
+        if (p < e && *p == '}') {
+            p++;
+            break;
+        }
+        goto bad;
+    }
+end:
+    p = ctl_ws(p, e);
+    if (p != e) goto bad;
+    if (!(seen & 1)) goto bad;
+    if (!r->is_set && seen != 1) goto bad; /* status takes no other key */
+    if (r->is_set && !(r->has_total || r->has_pid || r->has_floor || r->has_map)) goto bad;
+    return 0;
+bad:
+    if (err && err_len) snprintf(err, err_len, "bad request");
+    return -1;
+}
+
+/* ------------------------------------------------------------------ commands */
+
+static int ctl_status(char *out, size_t cap)
+{
+    vkb_mem_budget_cfg cfg;
+    vkb_mem_budget_client clients[VKB_MEM_BUDGET_CLIENTS];
+    int count = 0, n = 0;
+    int64_t total = 0;
+    vkb_mem_budget_get(&cfg);
+    vkb_mem_budget_usage(clients, VKB_MEM_BUDGET_CLIENTS, &count, &total);
+    unsigned long long avail = (unsigned long long)vkb_memavail_kb();
+    long long maps = (long long)vkb_mem_budget_maps();
+    long rss = ctl_rss_kb();
+#define APP(...)                                                                                                                      \
+    do {                                                                                                                              \
+        if (n < 0 || (size_t)n >= cap) goto overflow;                                                                                 \
+        int w_ = snprintf(out + n, cap - (size_t)n, __VA_ARGS__);                                                                     \
+        if (w_ < 0 || (size_t)w_ >= cap - (size_t)n) goto overflow;                                                                   \
+        n += w_;                                                                                                                      \
+    } while (0)
+    APP("{\"ok\":true,\"budget\":{\"total_mb\":%lld,\"pid_mb\":%lld,\"floor_mb\":%lld,\"map_limit\":%lld},"
+        "\"usage\":{\"total_bytes\":%lld,\"clients\":[",
+        (long long)cfg.total_mb, (long long)cfg.pid_mb, (long long)cfg.floor_mb, (long long)cfg.map_limit, (long long)total);
+    for (int i = 0; i < count && i < VKB_MEM_BUDGET_CLIENTS; i++)
+        APP("%s{\"pid\":%d,\"bytes\":%lld}", i ? "," : "", clients[i].pid, (long long)clients[i].bytes);
+    APP("]},\"system\":{\"mem_available_kb\":%llu,\"maps\":%lld,\"server_rss_kb\":%ld},\"clients_count\":%d}\n", avail, maps, rss, count);
+#undef APP
+    return n;
+overflow:
+    return -1;
+}
+
+static int ctl_do_set(const ctl_req *r, char *out, size_t cap, uid_t uid)
+{
+    vkb_mem_budget_cfg cfg;
+    vkb_mem_budget_get(&cfg);
+    if (r->has_total) cfg.total_mb = r->total_mb;
+    if (r->has_pid) cfg.pid_mb = r->pid_mb;
+    if (r->has_floor) cfg.floor_mb = r->floor_mb;
+    if (r->has_map) cfg.map_limit = r->map_limit;
+    if (!vkb_mem_budget_valid(&cfg)) return snprintf(out, cap, "{\"ok\":false,\"error\":\"budget values out of range\"}\n");
+    if (r->persist) {
+        char err[256], esc[768];
+        if (vkb_mem_budget_write_conf(&cfg, err, sizeof(err)) != 0) {
+            ctl_escape(esc, sizeof(esc), err);
+            return snprintf(out, cap, "{\"ok\":false,\"error\":\"persist failed: %s\"}\n", esc);
+        }
+    }
+    char warning[320] = "", esc[960];
+    if (vkb_mem_budget_set(&cfg, warning, sizeof(warning)) != 0)
+        return snprintf(out, cap, "{\"ok\":false,\"error\":\"budget rejected\"}\n");
+    VKB_INFO("control: budget set by uid %u: total %lld MB, per client %lld MB, MemAvailable floor %lld MB, map limit %lld%s",
+             (unsigned)uid, (long long)cfg.total_mb, (long long)cfg.pid_mb, (long long)cfg.floor_mb, (long long)cfg.map_limit,
+             r->persist ? ", written to budget.conf" : "");
+    if (warning[0]) {
+        ctl_escape(esc, sizeof(esc), warning);
+        return snprintf(out, cap, "{\"ok\":true,\"warning\":\"%s\"}\n", esc);
+    }
+    return snprintf(out, cap, "{\"ok\":true}\n");
+}
+
+static void ctl_handle(int fd, uid_t uid)
+{
+    char line[CTL_LINE_MAX + 2];
+    int64_t deadline = ctl_now_ms() + CTL_IDLE_MS;
+    for (;;) {
+        size_t len = 0;
+        int got = 0;
+        while (!got) {
+            int64_t left = deadline - ctl_now_ms();
+            if (left <= 0) {
+                ctl_reply_error(fd, "timeout");
+                return;
+            }
+            struct pollfd pfd = {.fd = fd, .events = POLLIN};
+            int pr = poll(&pfd, 1, (int)left);
+            if (pr < 0 && errno == EINTR) continue;
+            if (pr <= 0) {
+                ctl_reply_error(fd, "timeout");
+                return;
+            }
+            char c;
+            ssize_t k = recv(fd, &c, 1, 0);
+            if (k < 0 && errno == EINTR) continue;
+            if (k <= 0) return;
+            if (c == '\n') {
+                got = 1;
+                break;
+            }
+            if (len >= CTL_LINE_MAX) {
+                ctl_reply_error(fd, "line too long");
+                return;
+            }
+            line[len++] = c;
+        }
+        if (len && line[len - 1] == '\r') len--;
+        if (memchr(line, 0, len)) {
+            ctl_reply_error(fd, "NUL in request");
+            return;
+        }
+        ctl_req req;
+        char err[64];
+        if (ctl_parse(line, len, &req, err, sizeof(err))) {
+            ctl_reply_error(fd, err);
+            return;
+        }
+        char out[CTL_OUT_MAX];
+        int n = req.is_set ? ctl_do_set(&req, out, sizeof(out), uid) : ctl_status(out, sizeof(out));
+        if (n <= 0 || (size_t)n >= sizeof(out) || ctl_send(fd, out, (size_t)n)) return;
+        deadline = ctl_now_ms() + CTL_IDLE_MS;
+    }
+}
+
+static int ctl_peer_uid(int fd, uid_t *out)
+{
+    struct ucred cr;
+    socklen_t len = sizeof(cr);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cr, &len) != 0) return -1;
+    *out = cr.uid;
+    for (int i = 0; i < ctl_nuids; i++)
+        if (cr.uid == ctl_uids[i]) return 0;
+    VKB_WARN("control: refused uid %u pid %d (allowed: VKBRIDGE_CONTROL_UIDS)", (unsigned)cr.uid, (int)cr.pid);
+    return -1;
+}
+
+static void *ctl_thread(void *arg)
+{
+    (void)arg;
+    while (ctl_fd >= 0) {
+        struct pollfd pfd = {.fd = ctl_fd, .events = POLLIN};
+        int pr = poll(&pfd, 1, -1);
+        if (pr < 0) {
+            if (errno == EINTR) continue;
+            break;
+        }
+        if (!(pfd.revents & POLLIN)) continue;
+        int cfd = accept4(ctl_fd, NULL, NULL, SOCK_CLOEXEC);
+        if (cfd < 0) {
+            if (errno == EINTR || errno == EAGAIN) continue;
+            VKB_WARN("control: accept: %s", strerror(errno));
+            continue;
+        }
+        uid_t uid = (uid_t)-1;
+        if (ctl_peer_uid(cfd, &uid) == 0) ctl_handle(cfd, uid);
+        close(cfd);
+    }
+    return NULL;
+}
+
+static void ctl_cleanup(void)
+{
+    if (ctl_fd >= 0) close(ctl_fd);
+    ctl_fd = -1;
+    if (ctl_path[0]) unlink(ctl_path);
+}
+
+static void ctl_uids_init(void)
+{
+    const char *s = getenv("VKBRIDGE_CONTROL_UIDS");
+    if (!s || !*s) s = getenv("VKBRIDGE_CONTROL_UID");
+    if (!s || !*s) s = "1000";
+    char buf[256];
+    snprintf(buf, sizeof(buf), "%s", s);
+    char *save = NULL;
+    for (char *tok = strtok_r(buf, ", ", &save); tok && ctl_nuids < CTL_UIDS_MAX; tok = strtok_r(NULL, ", ", &save)) {
+        char *end = NULL;
+        long v = strtol(tok, &end, 10);
+        if (end != tok && !*end && v >= 0) ctl_uids[ctl_nuids++] = (uid_t)v;
+    }
+    if (!ctl_nuids) ctl_uids[ctl_nuids++] = 1000;
+}
+
+void vkb_control_start(const char *bridge_socket)
+{
+    const char *env = getenv("VKBRIDGE_CONTROL_SOCK");
+    if (env && (!strcmp(env, "off") || !strcmp(env, "0") || !strcmp(env, "none"))) {
+        VKB_INFO("control: disabled (VKBRIDGE_CONTROL_SOCK=%s)", env);
+        return;
+    }
+    if (env && *env) {
+        if (snprintf(ctl_path, sizeof(ctl_path), "%s", env) >= (int)sizeof(ctl_path)) {
+            VKB_ERR("control: socket path too long");
+            return;
+        }
+    } else {
+        const char *slash = bridge_socket ? strrchr(bridge_socket, '/') : NULL;
+        if (!slash) {
+            VKB_ERR("control: bridge socket has no directory: %s", bridge_socket ? bridge_socket : "(none)");
+            return;
+        }
+        size_t d = (size_t)(slash - bridge_socket);
+        if (d + strlen("/control.sock") + 1 > sizeof(ctl_path)) {
+            VKB_ERR("control: socket path too long");
+            return;
+        }
+        memcpy(ctl_path, bridge_socket, d);
+        ctl_path[d] = 0;
+        strcat(ctl_path, "/control.sock");
+    }
+    struct sockaddr_un a;
+    if (strlen(ctl_path) >= sizeof(a.sun_path)) {
+        VKB_ERR("control: socket path too long (%zu bytes): %s", strlen(ctl_path), ctl_path);
+        return;
+    }
+    ctl_uids_init();
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) {
+        VKB_ERR("control: socket: %s", strerror(errno));
+        return;
+    }
+    struct stat sb;
+    if (lstat(ctl_path, &sb) == 0) {
+        if (!S_ISSOCK(sb.st_mode)) {
+            VKB_ERR("control: %s exists and is not a socket; not replacing it", ctl_path);
+            close(fd);
+            return;
+        }
+        int probe = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        int live = 0;
+        if (probe >= 0) {
+            struct sockaddr_un pa;
+            memset(&pa, 0, sizeof(pa));
+            pa.sun_family = AF_UNIX;
+            strcpy(pa.sun_path, ctl_path);
+            live = connect(probe, (struct sockaddr *)&pa, sizeof(pa)) == 0;
+            close(probe);
+        }
+        if (live) {
+            VKB_ERR("control: %s is already served by another process", ctl_path);
+            close(fd);
+            return;
+        }
+        unlink(ctl_path);
+    }
+    memset(&a, 0, sizeof(a));
+    a.sun_family = AF_UNIX;
+    strcpy(a.sun_path, ctl_path);
+    if (bind(fd, (struct sockaddr *)&a, sizeof(a)) < 0) {
+        VKB_ERR("control: bind %s: %s", ctl_path, strerror(errno));
+        close(fd);
+        return;
+    }
+    chmod(ctl_path, 0666);
+    if (listen(fd, 8) < 0) {
+        VKB_ERR("control: listen: %s", strerror(errno));
+        close(fd);
+        unlink(ctl_path);
+        return;
+    }
+    ctl_fd = fd;
+    pthread_t t;
+    pthread_attr_t at;
+    pthread_attr_init(&at);
+    pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+    pthread_attr_setstacksize(&at, 256 * 1024);
+    int rc = pthread_create(&t, &at, ctl_thread, NULL);
+    pthread_attr_destroy(&at);
+    if (rc != 0) {
+        VKB_ERR("control: thread: %s", strerror(rc));
+        close(fd);
+        ctl_fd = -1;
+        unlink(ctl_path);
+        return;
+    }
+    atexit(ctl_cleanup);
+    char uids[96] = "";
+    int n = 0;
+    for (int i = 0; i < ctl_nuids; i++)
+        n += snprintf(uids + n, sizeof(uids) - (size_t)n, "%s%u", i ? "," : "", (unsigned)ctl_uids[i]);
+    VKB_INFO("control: listening on %s (mode 0666, uid %s)", ctl_path, uids);
+}
