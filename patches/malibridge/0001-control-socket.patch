+/* All four fields go in under one lock, so a refusal above changes nothing. The warning is a
+ * snapshot of what is already in use: lowering a limit keeps those allocations (they were made
+ * under the old one); only later ones fail with VK_ERROR_OUT_OF_DEVICE_MEMORY. */
+int vkb_mem_budget_set(const vkb_mem_budget_cfg *in, char *warning, size_t warning_len)
+{
+    if (warning && warning_len) warning[0] = 0;
+    if (!vkb_mem_budget_valid(in)) return -1;
+    pthread_once(&budget_once, budget_init);
+    pthread_mutex_lock(&budget_cfg_lock);
+    budget.pid_bytes = budget_mb_bytes(in->pid_mb);
+    budget.total_bytes = budget_mb_bytes(in->total_mb);
+    budget.avail_floor_kb = budget_mb_bytes(in->floor_mb) >> 10;
+    budget.map_limit = in->map_limit;
+    pthread_mutex_unlock(&budget_cfg_lock);
+    if (!warning || !warning_len) return 0;
+    int64_t used_total, used_pid = 0;
+    int max_pid = 0;
+    pthread_mutex_lock(&st.lock);
+    used_total = budget_live_locked() + budget.reserved;
+    for (int i = 0; i < ST_PIDS; i++)
+        if (st.pid[i].pid && st.pid[i].bytes > used_pid) used_pid = st.pid[i].bytes, max_pid = st.pid[i].pid;
+    pthread_mutex_unlock(&st.lock);
+    int n = 0;
+#define BUDGET_WARN(...)                                                                                                              \
+    do {                                                                                                                              \
+        if (n >= 0 && n < (int)warning_len) {                                                                                         \
+            int w = snprintf(warning + n, warning_len - (size_t)n, __VA_ARGS__);                                                      \
+            if (w > 0) n += w;                                                                                                        \
+        }                                                                                                                             \
+    } while (0)
+    if (in->total_mb && used_total > budget_mb_bytes(in->total_mb))
+        BUDGET_WARN("all clients use %lld MB, above the new total %lld MB", (long long)(used_total >> 20), (long long)in->total_mb);
+    if (in->pid_mb && used_pid > budget_mb_bytes(in->pid_mb))
+        BUDGET_WARN("%spid %d uses %lld MB, above the new per-client %lld MB", n ? "; " : "", max_pid, (long long)(used_pid >> 20),
+                    (long long)in->pid_mb);
+    if (n > 0) BUDGET_WARN("; existing allocations are kept, new ones fail");
+#undef BUDGET_WARN
+    return 0;
+}
+
+int vkb_mem_budget_usage(vkb_mem_budget_client *out, int max, int *count, int64_t *total_bytes)
+{
+    pthread_once(&budget_once, budget_init);
+    if (count) *count = 0;
+    if (total_bytes) *total_bytes = 0;
+    if (!out || max < 0) max = 0;
+    pthread_mutex_lock(&st.lock);
+    int64_t total = budget_live_locked() + budget.reserved;
+    int n = 0;
+    for (int i = 0; i < ST_PIDS; i++) {
+        int pid = st.pid[i].pid;
+        int64_t b = st.pid[i].bytes;
+        if (!pid || b <= 0) continue;
+        for (int j = 0; j < ST_PIDS; j++)
+            if (budget.res[j].pid == pid) b += budget.res[j].bytes;
+        int dup = 0;
+        for (int k = 0; k < n && k < max; k++)
+            if (out[k].pid == pid) {
+                out[k].bytes += b;
+                dup = 1;
+                break;
+            }
+        if (dup) continue;
+        if (n < max) out[n].pid = pid, out[n].bytes = b;
+        n++;
+    }
+    /* A reservation whose allocation has not been accounted yet has no st.pid entry. */
+    for (int i = 0; i < ST_PIDS; i++) {
+        int pid = budget.res[i].pid;
+        int64_t b = budget.res[i].bytes;
+        if (!pid || b <= 0) continue;
+        int seen = 0;
+        for (int j = 0; j < ST_PIDS && !seen; j++)
+            if (st.pid[j].pid == pid) seen = 1;
+        for (int k = 0; k < n && k < max && !seen; k++)
+            if (out[k].pid == pid) seen = 1;
+        if (seen) continue;
+        if (n < max) out[n].pid = pid, out[n].bytes = b;
+        n++;
+    }
+    pthread_mutex_unlock(&st.lock);
+    if (n > max) n = max;
+    if (count) *count = n;
+    if (total_bytes) *total_bytes = total;
+    return n;
+}
