+static char *budget_trim(char *s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    char *e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' || e[-1] == '\n')) *--e = 0;
+    return s;
+}
+
+/* 1: key found with a number, 0: absent or unknown, -1: a number the budget cannot use. */
+static int budget_conf_get(const char *path, const char *key, int64_t *out)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    char line[256];
+    int found = 0;
+    while (fgets(line, sizeof(line), f)) {
+        char *s = budget_trim(line);
+        if (!*s || *s == '#') continue;
+        char *eq = strchr(s, '=');
+        if (!eq) continue;
+        *eq = 0;
+        char *k = budget_trim(s), *v = budget_trim(eq + 1);
+        if (strcmp(k, key)) continue;
+        char *end = NULL;
+        long long n = strtoll(v, &end, 10);
+        if (end == v || *budget_trim(end) || n < 0) {
+            fclose(f);
+            return -1;
+        }
+        *out = (int64_t)n;
+        found = 1;
+    }
+    fclose(f);
+    return found;
+}
