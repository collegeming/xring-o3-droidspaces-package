+    if (ok && fsync(fd) != 0) ok = 0;
+    int saved = errno;
+    if (close(fd) != 0 && ok) ok = 0, saved = errno;
+    if (ok && rename(tmp, path) != 0) ok = 0, saved = errno;
+    if (!ok) {
+        unlink(tmp);
+        if (err && err_len) snprintf(err, err_len, "write %s: %s", path, strerror(saved));
+        return -1;
+    }
+    return 0;
+}
