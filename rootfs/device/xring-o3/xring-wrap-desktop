#!/bin/sh
# xring-wrap-desktop: 让桌面条目的启动方式与命令行启动一致地进入
# Wayland/GPU/零拷贝路径。
#
# 只有必须注入 per-app 参数/库的 Web 引擎类需要套 zc-run：
#   chromium / webkit / gecko / flutter
# GTK3/GTK4/Qt/GLFW 只依赖会话环境，保持原样，避免无谓的包装层。
#
# 包装保留原 Exec 文本（含 %U/%F 字段码），并且是幂等的；可在每次 pacman
# 事务后重复执行。绝对路径位于 /opt 的 Electron/WebKit 应用同时生成
# /usr/local/bin/<名字> 垫片，保证终端里直接敲命令也走同一路径。
#
# 有的应用经 shell 启动脚本进入（例如 /usr/bin/snishaper 里 `cd /opt/snishaper`
# 再 `exec ./SniShaper`）。zc-classify 只认 ELF，直接分类脚本会得到 unknown，
# 条目就被跳过。这里跟随脚本里的 cd/exec 找到真实二进制再分类；分类结果用于
# 决定是否包装，Exec 文本本身仍保持原样。
set -u

CLASSIFY=${ZC_CLASSIFY:-/opt/mali-stack/current/lib/zc-run/zc-classify}
ZC_RUN=/usr/local/bin/zc-run
BINDIR=/usr/local/bin

classify_impl() {
    _p=$1
    _depth=$2
    [ "$_depth" -lt 4 ] || return 1
    _p=$(readlink -f -- "$_p" 2>/dev/null) || return 1
    [ -f "$_p" ] || return 1
    _c=$("$CLASSIFY" "$_p" 2>/dev/null) || _c=
    case $_c in
        chromium|webkit|gecko|flutter) printf '%s\n' "$_c"; return 0 ;;
    esac
    head -c 2 "$_p" 2>/dev/null | grep -q '#!' || return 1
    _d=$(dirname -- "$_p")
    _cd=$(sed -n 's/^[[:space:]]*cd[[:space:]]\{1,\}\([^ ;&]*\).*/\1/p' "$_p" 2>/dev/null | tail -n 1)
    if [ -n "$_cd" ]; then
        case $_cd in
            /*) _d=$_cd ;;
            *) _d=$_d/$_cd ;;
        esac
    fi
    _t=$(sed -n 's/^[[:space:]]*exec[[:space:]]\{1,\}\([^ ;&]*\).*/\1/p' "$_p" 2>/dev/null | tail -n 1)
    [ -n "$_t" ] || return 1
    case $_t in
        /*) ;;
        *) _t=$_d/$_t ;;
    esac
    classify_impl "$_t" $((_depth + 1))
}

classify() { classify_impl "$1" 0; }

wrap_one() {
    f=$1
    [ -f "$f" ] || return 0
    line=$(grep -m1 '^Exec=' "$f" 2>/dev/null) || return 0
    cmd=${line#Exec=}
    case $cmd in *zc-run*) return 0 ;; esac

    # shellcheck disable=SC2086
    probe=$(printf '%s' "$cmd" | sed 's/ *%[a-zA-Z]//g')
    bin=$(printf '%s' "$probe" | awk '{print $1}')
    case $bin in
        /*) ;;
        *) bin=$(command -v "$bin" 2>/dev/null) || return 0 ;;
    esac
    [ -x "$bin" ] || return 0

    # 已经是调用 zc-run 的包装脚本时不再套一层。
    if [ -f "$bin" ] && head -c 4096 "$bin" 2>/dev/null | grep -q 'zc-run'; then
        return 0
    fi

    cls=$(classify "$bin") || return 0
    case $cls in
        chromium|webkit|gecko|flutter) ;;
        *) return 0 ;;
    esac

    tmp=$(mktemp) || return 0
    awk -v new="Exec=$ZC_RUN --class $cls $cmd" \
        'BEGIN{done=0} /^Exec=/{if(!done){print new; done=1; next}} {print}' \
        "$f" > "$tmp" && cat "$tmp" > "$f"
    rm -f "$tmp"
    echo "wrapped [$cls]: $f"

    base=$(basename -- "$bin")
    case $bin in
        /opt/*)
            if [ ! -e "$BINDIR/$base" ]; then
                tmp2=$(mktemp) || return 0
                printf '#!/bin/sh\nexec %s --class %s %s "$@"\n' \
                    "$ZC_RUN" "$cls" "$bin" > "$tmp2"
                install -m 0755 "$tmp2" "$BINDIR/$base" &&
                    echo "path shim: $BINDIR/$base"
                rm -f "$tmp2"
            fi
            ;;
    esac
}

if [ "$#" -eq 0 ]; then
    set -- /usr/share/applications/*.desktop
fi
for f in "$@"; do
    wrap_one "$f"
done
