# XRING-O3 MaliBridge host configuration.
#
# Every script in this directory reads this file after the real environment,
# so an exported variable wins over a value written here.
# install-host.sh copies this file to $SRV/host.env once and never overwrites it.
# The server-side names (VKBRIDGE_*) are derived from the values below.

# Droidspaces container name and its rootfs directory on the Android host.
CTR=archniri
ROOTFS=/data/local/Droidspaces/Containers/archniri/rootfs

# Where these scripts and the vkbridge-server binary live.
SRV=/data/local/tmp/xring-o3-host

# Stable alias that the container bind mount points at /run/display.sock.
ANLAND_LINK=/data/local/tmp/archniri-display.sock

# Version-independent alias for the Anland app's socket setting. anland-link.sh
# re-points it at the current container's socket on every start, so the app
# setting never has to change between container iterations (archniri12/13/...).
# Default: /data/local/tmp/archniri-latest-display.sock
# ANLAND_LATEST_LINK=/data/local/tmp/archniri-latest-display.sock

# Bridge memory budget. Passed to the server as VKBRIDGE_MEM_* on every start.
BUDGET_TOTAL_MB=6144
BUDGET_PID_MB=3072
BUDGET_FLOOR_MB=2048
MAP_LIMIT=60000

# Container uid allowed to use control.sock (mbctl / mb-tray).
# Comma-separated for several uids.
CONTROL_UIDS=1000

# Optional overrides; the defaults below match the layout above.
# SOCK_DIR=$ROOTFS/opt/mb-sock
# SERVER=$SRV/mbsrv/vkbridge-server
# BUDGET_CONF=$SOCK_DIR/budget.conf
# MEM_STATS=1
# DROIDSPACES_DIR=/data/local/Droidspaces
# DROIDSPACES_BIN=/data/local/Droidspaces/bin/droidspaces
