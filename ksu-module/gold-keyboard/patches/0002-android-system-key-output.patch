+static int emit_android_key(const struct input_event *original, int key, int value) {
+    if (g_android_fd < 0) {
+        return 0;
+    }
+    struct input_event output = *original;
+    output.type = EV_KEY;
+    output.code = (uint16_t)key;
+    output.value = value;
+    if (write_event(g_android_fd, &output) < 0) {
+        return -1;
+    }
+    // Written outside the batch, so the SYN is sent per key: it keeps the pair
+    // atomic for Android and costs nothing at keyboard event rates.
+    struct input_event sync = {0};
+    sync.type = EV_SYN;
+    sync.code = SYN_REPORT;
+    return write_event(g_android_fd, &sync);
+}
