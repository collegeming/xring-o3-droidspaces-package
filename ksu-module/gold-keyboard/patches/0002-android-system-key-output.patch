+/*
+ * Whether any profile sends a mapping to Android. The node is only worth
+ * creating when one does: an idle extra keyboard would still be picked up by
+ * every input scan on the device.
+ */
+static bool config_uses_android_output(void) {
+    Config *all = calloc(1, sizeof(*all));
+    if (all == NULL) {
+        return false;
+    }
+    load_config_profile(all, NULL);
+    bool used = false;
+    for (size_t index = 0; index < all->rule_count && !used; index++) {
+        used = all->rules[index].android_output;
+    }
+    free(all);
+    return used;
+}
+
+/*
+ * Creates the node Android-facing rules write to.
+ *
+ * Three properties keep it out of Anland's way while staying usable by MIUI:
+ * the name does not carry VIRTUAL_NAME_PREFIX, so Anland never mistakes it for
+ * Gold output; it declares no letter keys, so Anland classifies it as a button
+ * cluster rather than a keyboard and does not grab it; and it reports the Xiaomi
+ * identity, which is what makes MIUI run its native shortcut handling.
+ */
+static int create_android_keyboard(void) {
+    Config *all = calloc(1, sizeof(*all));
+    if (all == NULL) {
+        return -1;
+    }
+    // A NULL profile collects every section, so a later profile switch cannot
+    // ask for a key this node never declared.
+    load_config_profile(all, NULL);
+
+    int fd = open("/dev/uinput", O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        free(all);
+        return -1;
+    }
+    bool usable = ioctl(fd, UI_SET_EVBIT, EV_KEY) >= 0;
+    bool declared[KEY_MAX + 1] = {false};
+    for (size_t index = 0; index < all->rule_count && usable; index++) {
+        const MappingRule *rule = &all->rules[index];
+        if (!rule->android_output) {
+            continue;
+        }
+        for (size_t key_index = 0; key_index < rule->target_count; key_index++) {
+            int key = rule->target[key_index];
+            if (key < 0 || key > KEY_MAX || declared[key]) {
+                continue;
+            }
+            declared[key] = true;
+            if (ioctl(fd, UI_SET_KEYBIT, key) < 0) {
+                usable = false;
+                break;
+            }
+        }
+    }
+    free(all);
+    if (!usable) {
+        close(fd);
+        return -1;
+    }
+
+    struct uinput_setup setup = {0};
+    snprintf(setup.name, sizeof(setup.name), "%s", VIRTUAL_ANDROID_NAME);
+    setup.id.bustype = BUS_USB;
+    setup.id.vendor = VIRTUAL_ANDROID_VENDOR;
+    setup.id.product = VIRTUAL_ANDROID_PRODUCT;
+    // Must differ from the Gold output nodes' 0x0101. Android's InputReader
+    // folds event nodes that share vendor/product/bus/version into a single
+    // InputDevice and names it after whichever node it met first; the merged
+    // device then hides the Gold name from Anland's InputManager discovery.
+    setup.id.version = 0x0102;
+    if (ioctl(fd, UI_DEV_SETUP, &setup) < 0 || ioctl(fd, UI_DEV_CREATE) < 0) {
+        close(fd);
+        return -1;
+    }
+    fprintf(stderr, "fn-remap: Android key output on '%s' (%04x:%04x)\n",
+            VIRTUAL_ANDROID_NAME, VIRTUAL_ANDROID_VENDOR, VIRTUAL_ANDROID_PRODUCT);
+    return fd;
+}
